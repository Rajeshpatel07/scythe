{
  "manifest_version": 3,
  "name": "Scythe",
  "version": "1.0",
  "description": "Cut through the noise. Find instantly.",
  "permissions": [
    "storage",
    "history",
    "favicon",
    "tabs",
    "webNavigation",
    "browsingData",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "action": {
    "default_title": "Scythe Settings",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/glance/escape-forwarder.js",
        "src/content/glance/csp-stripper.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-spotlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Spotlight Search"
    },
    "toggle-tab-switcher": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "MacCtrl+Space"
      },
      "description": "Open Tab Switcher"
    },
    "toggle-tab-switcher-reverse": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Open Tab Switcher (Reverse)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/assets/icon48.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
